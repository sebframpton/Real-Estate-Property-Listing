---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Investment Portfolios | ListedHomes">
    <div class="bg-primary text-white py-16">
        <div class="container mx-auto px-4">
            <h1 class="text-4xl md:text-5xl font-bold font-display mb-4 italic">
                Investment <span class="text-accent underline">Portfolios</span>
            </h1>
            <p class="text-gray-300">
                Strategic wealth creation through real estate.
            </p>
        </div>
    </div>

    <section
        class="py-24 bg-white min-h-[50vh] flex items-center justify-center"
    >
        <div class="text-center max-w-2xl px-4">
            <h2 class="text-3xl font-bold text-primary mb-6">
                Grow Your Wealth
            </h2>
            <p class="text-gray-500 text-lg mb-8 leading-relaxed">
                Discover exclusive investment opportunities tailored to your
                financial goals. Our experts analyze market trends to bring you
                high-yield portfolios and off-market opportunities.
            </p>
            <a
                href="/listings"
                class="inline-flex px-8 py-3 bg-accent text-secondary font-bold rounded-xl hover:bg-accent/90 transition-all"
            >
                Explore Investments
            </a>
        </div>
    </section>
</Layout>
