---
import Layout from "../layouts/Layout.astro";
import properties from "../data/properties.json";

// Extract unique agents
const allAgents = properties.map(p => p.agent);
const uniqueAgentsMap = new Map();
allAgents.forEach(agent => {
    if (!uniqueAgentsMap.has(agent.name)) {
        uniqueAgentsMap.set(agent.name, {
            ...agent,
            bio: getBioForAgent(agent.name),
            listingsCount: properties.filter(p => p.agent.name === agent.name).length
        });
    }
});
const agents = Array.from(uniqueAgentsMap.values());

function getBioForAgent(name: string): string {
    const bios: Record<string, string> = {
        "Sarah Jenkins": "With over 15 years of experience in the luxury market, Sarah is known for her attention to detail and unwavering commitment to her clients' goals.",
        "Emma Thompson": "Emma brings a fresh, data-driven approach to real estate. Her background in finance helps her clients make the smartest investment decisions.",
        "Michael Chen": "A specialist in urban developments and modern townhouses, Michael has a deep understanding of the city's ever-evolving property landscape.",
        "David Wilson": "David is our land and acreage expert. His knowledge of zoning laws and development potential is second to none."
    };
    return bios[name] || "A dedicated real estate professional committed to providing exceptional service and achieving the best results for every client.";
}
---

<Layout title="Our Expert Agents | Listed Homes" description="Meet our team of experienced real estate professionals dedicated to helping you find your dream home.">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 bg-primary overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 left-0 w-96 h-96 bg-accent rounded-full -translate-x-1/2 -translate-y-1/2 blur-3xl"></div>
            <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent rounded-full translate-x-1/2 translate-y-1/2 blur-3xl"></div>
        </div>
        
        <div class="container mx-auto px-4 relative z-10 text-center">
            <span class="inline-block bg-accent/20 text-accent px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-widest mb-6">Expert Team</span>
            <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 font-display italic">Meet Our <span class="text-accent underline decoration-white/20">Specialists</span></h1>
            <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                Our agents are more than just salespeople—they are local experts with a deep passion for the communities they serve.
            </p>
        </div>
    </section>

    <!-- Agents Grid -->
    <section class="py-24 bg-background-base">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                {agents.map((agent: any) => (
                    <div class="group bg-white rounded-[40px] overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 border border-gray-100 flex flex-col h-full">
                        <!-- Agent Image -->
                        <div class="relative pt-[120%] overflow-hidden bg-gray-100">
                            <img 
                                src={agent.image} 
                                alt={agent.name}
                                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-8">
                                <div class="flex space-x-4">
                                    <div class="w-10 h-10 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center text-white hover:bg-accent hover:text-secondary transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/></svg>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-10 flex-grow">
                            <div class="flex justify-between items-start mb-4">
                                <div>
                                    <h3 class="text-2xl font-bold text-primary mb-1 group-hover:text-accent transition-colors">{agent.name}</h3>
                                    <p class="text-accent font-bold text-sm uppercase tracking-widest">Property Specialist</p>
                                </div>
                                <div class="bg-primary/5 px-3 py-1 rounded-full text-xs font-bold text-primary flex items-center">
                                    <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
                                    {agent.listingsCount} Listings
                                </div>
                            </div>
                            
                            <p class="text-gray-500 mb-8 leading-relaxed italic">
                                "{agent.bio}"
                            </p>

                            <div class="space-y-4 pt-6 border-t border-gray-100">
                                <a href={`mailto:${agent.email}`} class="flex items-center text-gray-600 hover:text-accent transition-colors group/link">
                                    <div class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center mr-3 group-hover/link:bg-accent/10">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 group-hover/link:text-accent"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                    </div>
                                    <span class="text-sm font-medium">{agent.email}</span>
                                </a>
                                <a href={`tel:${agent.phone}`} class="flex items-center text-gray-600 hover:text-accent transition-colors group/link">
                                    <div class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center mr-3 group-hover/link:bg-accent/10">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 group-hover/link:text-accent"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                    </div>
                                    <span class="text-sm font-medium">{agent.phone}</span>
                                </a>
                            </div>
                        </div>

                        <div class="px-10 pb-10">
                            <button class="w-full bg-primary text-white font-bold py-4 rounded-2xl hover:bg-accent hover:text-secondary transition-all transform group-hover:scale-[1.02] shadow-lg shadow-primary/10">
                                View Profile
                            </button>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Join Us CTA -->
    <section class="py-24 bg-white overflow-hidden relative">
        <div class="container mx-auto px-4 text-center relative z-10">
            <h2 class="text-4xl md:text-5xl font-bold text-primary mb-8 font-display italic">Want to join our <span class="text-accent underline">elite team?</span></h2>
            <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-12">
                We are always looking for passionate, driven individuals to help us redefine the real estate experience.
            </p>
            <a href="/contact" class="inline-block bg-primary text-white px-12 py-5 rounded-2xl font-bold hover:bg-accent transition-all transform hover:scale-110 shadow-xl shadow-primary/20">
                Apply Now
            </a>
        </div>
    </section>
</Layout>
