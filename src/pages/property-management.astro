---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Property Management | ListedHomes">
    <div class="bg-primary text-white py-16">
        <div class="container mx-auto px-4">
            <h1 class="text-4xl md:text-5xl font-bold font-display mb-4 italic">
                Property <span class="text-white underline">Management</span>
            </h1>
            <p class="text-gray-300">
                Professional management for your luxury assets.
            </p>
        </div>
    </div>

    <section
        class="py-24 bg-white min-h-[50vh] flex items-center justify-center"
    >
        <div class="text-center max-w-2xl px-4">
            <h2 class="text-3xl font-bold text-primary mb-6">
                Expert Management Services
            </h2>
            <p class="text-gray-500 text-lg mb-8 leading-relaxed">
                Our property management team provides comprehensive services to
                ensure your investment is protected and your returns are
                maximized. We handle everything from tenant screening to
                maintenance.
            </p>
            <a
                href="/listings"
                class="inline-flex px-8 py-3 bg-accent text-secondary font-bold rounded-xl hover:bg-accent/90 transition-all"
            >
                View Our Portfolio
            </a>
        </div>
    </section>
</Layout>
