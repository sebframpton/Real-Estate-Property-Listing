---
import Layout from "../../layouts/Layout.astro";
import properties from "../../data/properties.json";
import PropertyCard from "../../components/PropertyCard.astro";

const { id } = Astro.params;
const property = properties.find((p) => p.id === id);

if (!property) {
    return Astro.redirect("/404");
}

const formattedPrice = new Intl.NumberFormat("en-AU", {
    style: "currency",
    currency: "AUD",
    maximumFractionDigits: 0,
}).format(property.price);

const similarProperties = properties
    .filter((p) => p.type === property.type && p.id !== property.id)
    .slice(0, 3);

const galleryImagesJson = JSON.stringify(property.gallery || [property.image]);
const coordsJson = JSON.stringify(property.coordinates || [-28.0167, 153.4]);
---

<Layout title={property.title} description={property.description}>
    <!-- Top Gallery & Title Section -->
    <section class="bg-white pt-8 pb-12">
        <div class="container mx-auto px-4">
            <div
                class="flex flex-col md:flex-row justify-between items-start mb-8 gap-4"
            >
                <div>
                    <div
                        class="flex items-center space-x-2 text-accent bg-accent/10 px-3 py-1 rounded-lg text-sm font-bold uppercase tracking-wider mb-4 w-fit"
                    >
                        <span>{property.type} for Sale</span>
                    </div>
                    <h1
                        class="text-4xl md:text-5xl font-bold font-display text-primary mb-2 italic tracking-tight"
                    >
                        {property.title}
                    </h1>
                    <p class="text-gray-500 flex items-center text-lg">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mr-2 text-accent"
                            ><path
                                d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                            ></path><circle cx="12" cy="10" r="3"></circle></svg
                        >
                        {property.location}
                    </p>
                </div>
                <!-- pricing and share buttons ... -->
                <div class="flex flex-col items-end">
                    <div class="text-4xl font-bold text-primary mb-4">
                        {formattedPrice}{
                            property.price < 50000 ? " per month" : ""
                        }
                    </div>
                    <div class="flex space-x-3">
                        <button
                            class="p-3 border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors flex items-center space-x-2 font-medium"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><circle cx="18" cy="5" r="3"></circle><circle
                                    cx="6"
                                    cy="12"
                                    r="3"></circle><circle cx="18" cy="19" r="3"
                                ></circle><line
                                    x1="8.59"
                                    y1="13.51"
                                    x2="15.42"
                                    y2="17.49"></line><line
                                    x1="15.41"
                                    y1="6.51"
                                    x2="8.59"
                                    y2="10.49"></line></svg
                            >
                            <span>Share</span>
                        </button>
                        <button
                            class="p-3 border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors flex items-center space-x-2 font-medium"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                                ></path></svg
                            >
                            <span>Save</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Hero Image Gallery -->
            <div class="space-y-4">
                <div
                    class="w-full aspect-[21/9] h-[350px] md:h-[550px] lg:h-[650px] overflow-hidden rounded-3xl relative group shadow-2xl"
                >
                    <img
                        id="main-image"
                        src={property.image}
                        alt={property.title}
                        class="w-full h-full object-cover transition-opacity duration-300 cursor-zoom-in group-hover:scale-105"
                    />
                </div>

                {
                    property.gallery && property.gallery.length > 0 && (
                        <div class="grid grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-4">
                            {property.gallery.map(
                                (img: string, index: number) => (
                                    <button
                                        class={`gallery-thumb aspect-square rounded-xl overflow-hidden border-2 transition-all focus:outline-none focus:ring-2 focus:ring-accent ${index === 0 ? "border-accent" : "border-transparent"}`}
                                        data-image={img}
                                    >
                                        <img
                                            src={img}
                                            alt={`${property.title} view ${index + 1}`}
                                            class="w-full h-full object-cover"
                                        />
                                    </button>
                                ),
                            )}
                        </div>
                    )
                }
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 bg-background-base">
        <div class="container mx-auto px-4">
            <div class="flex flex-col lg:flex-row gap-12">
                <!-- Main Content -->
                <div class="lg:w-2/3 space-y-12">
                    <!-- Key Stats -->
                    <div
                        class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex justify-between items-center text-center"
                    >
                        <div class="flex-1 border-r border-gray-100">
                            <div class="text-accent mb-2 flex justify-center">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M2 7v10c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2v-4h4v4c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2V7"
                                    ></path><polyline points="2 7 12 3 22 7"
                                    ></polyline></svg
                                >
                            </div>
                            <div class="text-2xl font-bold">
                                {property.beds}
                            </div>
                            <div
                                class="text-gray-400 text-sm font-medium uppercase tracking-widest"
                            >
                                Bedrooms
                            </div>
                        </div>
                        <div class="flex-1 border-r border-gray-100">
                            <div class="text-accent mb-2 flex justify-center">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M8 2v3M16 2v3M3.5 19.5h17M3.5 7h17M6.5 7v12.5M17.5 7v12.5"
                                    ></path></svg
                                >
                            </div>
                            <div class="text-2xl font-bold">
                                {property.baths}
                            </div>
                            <div
                                class="text-gray-400 text-sm font-medium uppercase tracking-widest"
                            >
                                Bathrooms
                            </div>
                        </div>
                        <div class="flex-1 border-r border-gray-100">
                            <div class="text-accent mb-2 flex justify-center">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M3 3h18v18H3zM9 3v18M15 3v18M3 9h18M3 15h18"
                                    ></path></svg
                                >
                            </div>
                            <div class="text-2xl font-bold">
                                {property.area}
                            </div>
                            <div
                                class="text-gray-400 text-sm font-medium uppercase tracking-widest"
                            >
                                Sq Metres
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="text-accent mb-2 flex justify-center">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="28"
                                    height="28"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><circle cx="12" cy="12" r="10"
                                    ></circle><path d="M12 8v4l3 3"></path></svg
                                >
                            </div>
                            <div class="text-2xl font-bold">
                                {property.parking || 2}
                            </div>
                            <div
                                class="text-gray-400 text-sm font-medium uppercase tracking-widest"
                            >
                                Car Spaces
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div
                        class="bg-white p-10 rounded-3xl shadow-sm border border-gray-100"
                    >
                        <h2 class="text-3xl font-bold font-display mb-6 italic">
                            About This <span class="text-accent">Property</span>
                        </h2>
                        <div
                            class="prose prose-slate max-w-none text-gray-500 leading-relaxed text-lg"
                        >
                            <p>{property.description}</p>
                        </div>
                    </div>

                    <!-- Features -->
                    <div
                        class="bg-white p-10 rounded-3xl shadow-sm border border-gray-100"
                    >
                        <h2
                            class="text-3xl font-bold font-display mb-10 italic"
                        >
                            Property <span class="text-accent">Features</span>
                        </h2>
                        <div
                            class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12"
                        >
                            {
                                property.features.map((feature: string) => (
                                    <div class="flex items-center space-x-3 group">
                                        <div class="w-10 h-10 bg-accent/10 rounded-full flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-all">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                        </div>
                                        <span class="text-lg font-medium text-gray-700">
                                            {feature}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Map -->
                    <div
                        class="bg-white p-10 rounded-3xl shadow-sm border border-gray-100"
                    >
                        <h2
                            class="text-3xl font-bold font-display mb-10 italic"
                        >
                            Property <span class="text-accent">Location</span>
                        </h2>
                        <div
                            id="map"
                            data-coords={coordsJson}
                            class="h-[400px] rounded-2xl bg-gray-100 border border-gray-200 overflow-hidden relative"
                        >
                            <div
                                class="absolute inset-0 flex items-center justify-center text-gray-400 flex-col"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="48"
                                    height="48"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="mb-4 animate-bounce"
                                    ><path
                                        d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                                    ></path><circle cx="12" cy="10" r="3"
                                    ></circle></svg
                                >
                                <span class="font-bold">Map Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <aside class="lg:w-1/3">
                    <div class="sticky top-28 space-y-8">
                        <div
                            class="bg-primary text-white p-10 rounded-3xl shadow-2xl relative overflow-hidden"
                        >
                            <div
                                class="absolute top-0 right-0 w-32 h-32 bg-accent/20 rounded-bl-full"
                            >
                            </div>
                            <h3
                                class="text-2xl font-bold mb-8 font-display italic"
                            >
                                Listed by
                            </h3>
                            <div class="flex items-center space-x-6 mb-8">
                                <div
                                    class="w-24 h-24 rounded-2xl border-2 border-accent p-1"
                                >
                                    <img
                                        src={property.agent.image}
                                        alt={property.agent.name}
                                        class="w-full h-full object-cover rounded-xl"
                                    />
                                </div>
                                <div>
                                    <h4 class="text-xl font-bold text-accent">
                                        {property.agent.name}
                                    </h4>
                                    <p class="text-gray-300 text-sm">
                                        Property Specialist
                                    </p>
                                </div>
                            </div>
                            <div class="space-y-4">
                                <a
                                    href={`tel:${property.agent.phone}`}
                                    class="flex items-center space-x-4 p-4 bg-white/10 hover:bg-white/20 rounded-xl transition-all border border-white/10"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-accent"
                                        ><path
                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                        ></path></svg
                                    >
                                    <span class="font-bold"
                                        >{property.agent.phone}</span
                                    >
                                </a>
                                <a
                                    href={`mailto:${property.agent.email}`}
                                    class="flex items-center space-x-4 p-4 bg-white/10 hover:bg-white/20 rounded-xl transition-all border border-white/10"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-accent"
                                        ><rect
                                            x="2"
                                            y="4"
                                            width="20"
                                            height="16"
                                            rx="2"></rect><path
                                            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                        ></path></svg
                                    >
                                    <span class="font-bold">Email Agent</span>
                                </a>
                            </div>
                            <hr class="my-8 border-white/10" />
                            <button
                                class="w-full bg-accent text-secondary font-bold py-4 rounded-xl hover:bg-accent/90 transition-all transform hover:scale-[1.02]"
                                >Inquire Now</button
                            >
                        </div>
                    </div>
                </aside>
            </div>

            {
                similarProperties.length > 0 && (
                    <div class="mt-24">
                        <h2 class="text-3xl font-bold font-display mb-12 italic text-center">
                            Similar <span class="text-accent">Properties</span>
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                            {similarProperties.map((p) => (
                                <PropertyCard {...p} />
                            ))}
                        </div>
                    </div>
                )
            }
        </div>
    </section>

    <!-- Modal Gallery -->
    <div
        id="image-modal"
        class="fixed inset-0 z-[100] hidden bg-black/95 backdrop-blur-sm items-center justify-center p-4"
    >
        <button
            id="close-modal"
            class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors z-[110]"
            aria-label="Close modal"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="40"
                height="40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M18 6 6 18M6 6l12 12"></path></svg
            >
        </button>
        <button
            id="prev-btn"
            class="absolute left-4 md:left-8 text-white/70 hover:text-white transition-colors p-4 bg-white/5 rounded-full hover:bg-white/10 z-[110]"
            aria-label="Previous image"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
            >
        </button>
        <div
            class="relative max-w-7xl max-h-[85vh] w-full flex items-center justify-center"
        >
            <img
                id="modal-image"
                src=""
                alt="Property Gallery"
                class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl transition-opacity duration-300"
            />
        </div>
        <button
            id="next-btn"
            class="absolute right-4 md:right-8 text-white/70 hover:text-white transition-colors p-4 bg-white/5 rounded-full hover:bg-white/10 z-[110]"
            aria-label="Next image"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
            >
        </button>
    </div>

    <!-- Leaflet -->
    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    ></script>

    <script is:inline define:vars={{ galleryImagesJson, coordsJson }}>
        document.addEventListener("DOMContentLoaded", () => {
            const mapElement = document.getElementById("map");
            if (mapElement && typeof L !== "undefined") {
                const coords = JSON.parse(coordsJson);
                const map = L.map("map").setView(coords, 14);
                L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                ).addTo(map);
                const customIcon = L.divIcon({
                    html: `<div style="background-color: #d4a853; color: white; padding: 0.5rem; border-radius: 9999px; border: 2px solid white; display: flex; align-items: center; justify-content: center;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>`,
                    className: "custom-pin",
                    iconSize: [36, 36],
                    iconAnchor: [18, 36],
                });
                L.marker(coords, { icon: customIcon }).addTo(map);
            }

            const mainImage = document.getElementById("main-image");
            const thumbs = document.querySelectorAll(".gallery-thumb");
            const galleryImages = JSON.parse(galleryImagesJson);
            let currentIndex = 0;

            const modal = document.getElementById("image-modal");
            const modalImg = document.getElementById("modal-image");
            const closeModal = document.getElementById("close-modal");
            const prevBtn = document.getElementById("prev-btn");
            const nextBtn = document.getElementById("next-btn");

            function updateThumbnails(index) {
                thumbs.forEach((t, i) => {
                    if (i === index) t.classList.add("border-accent");
                    else t.classList.remove("border-accent");
                });
            }

            thumbs.forEach((thumb, index) => {
                thumb.addEventListener("click", () => {
                    const newSrc = galleryImages[index];
                    if (mainImage && newSrc) {
                        mainImage.style.opacity = "0";
                        setTimeout(() => {
                            mainImage.src = newSrc;
                            mainImage.style.opacity = "1";
                        }, 150);
                        currentIndex = index;
                        updateThumbnails(index);
                    }
                });
            });

            if (mainImage) {
                mainImage.addEventListener("click", () => {
                    if (modal && modalImg) {
                        modalImg.src = galleryImages[currentIndex];
                        modal.style.display = "flex";
                        document.body.style.overflow = "hidden";
                    }
                });
            }

            closeModal?.addEventListener("click", () => {
                modal.style.display = "none";
                document.body.style.overflow = "";
            });

            prevBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                currentIndex =
                    (currentIndex - 1 + galleryImages.length) %
                    galleryImages.length;
                modalImg.src = galleryImages[currentIndex];
            });

            nextBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                currentIndex = (currentIndex + 1) % galleryImages.length;
                modalImg.src = galleryImages[currentIndex];
            });
        });
    </script>
</Layout>
