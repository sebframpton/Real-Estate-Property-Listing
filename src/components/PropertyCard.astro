---
import { Bed, Bath, Move, MapPin, Heart } from "lucide-astro";

interface Props {
    id: string;
    title: string;
    price: number;
    location: string;
    type: string;
    beds: number;
    baths: number;
    area: number;
    image: string;
}

const { id, title, price, location, type, beds, baths, area, image } =
    Astro.props;

const formattedPrice = new Intl.NumberFormat("en-AU", {
    style: "currency",
    currency: "AUD",
    maximumFractionDigits: 0,
}).format(price);
---

<div
    class="group bg-white rounded-2xl overflow-hidden shadow-[0_2px_8px_rgba(0,0,0,0.08)] hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 relative border border-gray-50"
>
    <!-- Image Container -->
    <div class="relative aspect-[4/3] overflow-hidden">
        <img
            src={image}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
        />
        <div
            class="absolute top-4 left-4 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-lg shadow-sm"
        >
            <span
                class="text-xs font-bold text-primary uppercase tracking-wider"
                >{type}</span
            >
        </div>
        <button
            class="absolute top-4 right-4 p-2.5 bg-white/20 backdrop-blur-sm hover:bg-white text-white hover:text-red-500 rounded-full transition-all border border-white/30"
        >
            <Heart size={18} />
        </button>
    </div>

    <!-- Content -->
    <div class="p-6">
        <div class="flex justify-between items-start mb-2">
            <h3
                class="text-xl font-bold text-primary font-display group-hover:text-accent transition-colors"
            >
                <a href={`/property/${id}`}>{title}</a>
            </h3>
        </div>

        <div class="flex items-center text-gray-500 text-sm mb-4">
            <MapPin size={16} class="mr-1.5 text-accent" />
            <span>{location}</span>
        </div>

        <div
            class="flex items-center justify-between mb-6 pt-4 border-t border-gray-50"
        >
            <div
                class="flex items-center space-x-1.5 text-text-main font-medium"
            >
                <Bed size={18} class="text-gray-400" />
                <span>{beds}</span>
            </div>
            <div
                class="flex items-center space-x-1.5 text-text-main font-medium"
            >
                <Bath size={18} class="text-gray-400" />
                <span>{baths}</span>
            </div>
            <div
                class="flex items-center space-x-1.5 text-text-main font-medium"
            >
                <Move size={18} class="text-gray-400" />
                <span>{area}m²</span>
            </div>
        </div>

        <div class="flex items-center justify-between">
            <span class="text-2xl font-bold text-primary"
                >{formattedPrice}{price < 50000 ? " per month" : ""}</span
            >
            <a
                href={`/property/${id}`}
                class="text-sm font-bold text-accent hover:underline flex items-center group/link"
            >
                View Details
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 ml-1 transform group-hover/link:translate-x-1 transition-transform"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </div>
    </div>
</div>
