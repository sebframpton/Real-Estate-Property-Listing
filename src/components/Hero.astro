---
import { Search, MapPin, Home, DollarSign } from "lucide-astro";

const propertyTypes = ["House", "Unit", "Townhouse", "Land"];
const priceRanges = ["$500k - $1M", "$1M - $2M", "$2M - $5M", "$5M+"];
---

<section
    class="relative h-[85vh] flex items-center justify-center overflow-hidden bg-primary"
>
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
        <img
            src="/images/House/Australian_home_08a8390313.jpeg"
            alt="Luxury Real Estate"
            class="w-full h-full object-cover opacity-60 scale-105 hover:scale-100 transition-transform duration-10000"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-primary/40 via-transparent to-primary/80"
        >
        </div>
    </div>

    <div class="container mx-auto px-4 z-10 text-center">
        <h1
            class="text-5xl md:text-7xl font-display font-bold text-white mb-6 leading-tight animate-fade-in"
        >
            Elevate Your <span class="text-accent italic">Living</span> Standards
        </h1>
        <p
            class="text-xl text-gray-200 mb-12 max-w-2xl mx-auto leading-relaxed"
        >
            Discover an exclusive collection of premium properties tailored to
            your lifestyle. Excellence in every detail, home in every corner.
        </p>

        <!-- Search Box -->
        <form
            action="/listings"
            method="get"
            class="max-w-4xl mx-auto bg-white p-2 md:p-4 rounded-2xl shadow-2xl flex flex-col md:flex-row items-center gap-4"
        >
            <div class="flex-1 w-full grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Location -->
                <div
                    class="flex items-center space-x-3 px-4 py-2 border-r border-gray-100 last:border-0"
                >
                    <MapPin class="text-accent" size={20} />
                    <div class="text-left w-full">
                        <span
                            class="text-xs text-gray-400 font-bold uppercase tracking-wider"
                            >Location</span
                        >
                        <input
                            type="text"
                            name="q"
                            placeholder="Where to?"
                            class="w-full text-sm font-medium focus:outline-none"
                        />
                    </div>
                </div>

                <!-- Property Type -->
                <div
                    class="flex items-center space-x-3 px-4 py-2 border-r border-gray-100 last:border-0"
                >
                    <Home class="text-accent" size={20} />
                    <div class="text-left w-full">
                        <span
                            class="text-xs text-gray-400 font-bold uppercase tracking-wider"
                            >Property Type</span
                        >
                        <select
                            name="type"
                            class="w-full text-sm font-medium focus:outline-none bg-transparent"
                        >
                            <option value="All">All Types</option>
                            {
                                propertyTypes.map((type) => (
                                    <option value={type}>{type}</option>
                                ))
                            }
                        </select>
                    </div>
                </div>

                <!-- Price Range -->
                <div
                    class="flex items-center space-x-3 px-4 py-2 border-r border-gray-100 last:border-0"
                >
                    <DollarSign class="text-accent" size={20} />
                    <div class="text-left w-full">
                        <span
                            class="text-xs text-gray-400 font-bold uppercase tracking-wider"
                            >Price Range</span
                        >
                        <select
                            name="priceRange"
                            class="w-full text-sm font-medium focus:outline-none bg-transparent"
                        >
                            <option value="All">All Prices</option>
                            {
                                priceRanges.map((range) => (
                                    <option value={range}>{range}</option>
                                ))
                            }
                        </select>
                    </div>
                </div>
            </div>

            <button
                type="submit"
                class="w-full md:w-auto bg-accent text-secondary px-10 py-4 rounded-xl font-bold flex items-center justify-center space-x-2 hover:bg-accent/90 transition-all transform hover:scale-[1.02] shadow-lg"
            >
                <Search size={20} />
                <span>Search</span>
            </button>
        </form>
    </div>
</section>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fade-in 1s ease-out forwards;
    }
</style>
