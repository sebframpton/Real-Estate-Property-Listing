---
import properties from "../data/properties.json";

function getCount(type: string) {
    return properties.filter((p) => p.type === type).length;
}

const propertyTypes = [
    { name: "House", icon: "🏠", count: getCount("House"), href: "/houses" },
    { name: "Unit", icon: "🏢", count: getCount("Unit"), href: "/units" },
    {
        name: "Townhouse",
        icon: "🏡",
        count: getCount("Townhouse"),
        href: "/townhouses",
    },
    { name: "Land", icon: "🌳", count: getCount("Land"), href: "/lands" },
];
---

<section class="py-24 bg-white">
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold mb-4">
                Explore by <span class="text-accent">Property Type</span>
            </h2>
            <p class="text-gray-500 max-w-xl mx-auto">
                Find exactly what you're looking for by browsing our curated
                categories of premium real estate.
            </p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
            {
                propertyTypes.map((type) => (
                    <a
                        href={type.href}
                        class="group p-8 rounded-2xl border border-gray-100 hover:border-accent hover:shadow-xl transition-all text-center"
                    >
                        <div class="text-5xl mb-6 group-hover:scale-110 transition-transform">
                            {type.icon}
                        </div>
                        <h3 class="text-xl font-bold mb-2 group-hover:text-accent transition-colors">
                            {type.name}s
                        </h3>
                        <p class="text-gray-400 text-sm font-medium">
                            {type.count} Properties
                        </p>
                    </a>
                ))
            }
        </div>
    </div>
</section>
