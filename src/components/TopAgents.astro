---
import { Star, ArrowRight, TrendingUp } from "lucide-astro";

const topAgents = [
    {
        name: "Sarah Jenkins",
        role: "Luxury Property Specialist",
        image: "https://ui-avatars.com/api/?name=Sarah+Jenkins&background=1a2e4a&color=d4a853&size=200",
        stats: "150+ Properties Sold",
    },
    {
        name: "Michael Chen",
        role: "Senior Portfolio Manager",
        image: "https://ui-avatars.com/api/?name=Michael+Chen&background=1a2e4a&color=d4a853&size=200",
        stats: "12 Years Experience",
    },
    {
        name: "Emma Thompson",
        role: "Heritage & Estate Expert",
        image: "https://ui-avatars.com/api/?name=Emma+Thompson&background=1a2e4a&color=d4a853&size=200",
        stats: "98% Client Satisfaction",
    },
];
---

<section class="py-24 bg-white overflow-hidden" id="agents">
    <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row items-center gap-16">
            <div class="lg:w-1/3">
                <div
                    class="inline-flex items-center space-x-2 text-accent bg-accent/10 px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-wider mb-6"
                >
                    <Star size={16} fill="currentColor" />
                    <span>Top Rated Portfolio</span>
                </div>
                <h2 class="text-4xl lg:text-5xl font-bold mb-8 leading-tight">
                    Meet Our <span
                        class="text-accent underline decoration-4 underline-offset-8"
                        >Expert</span
                    > Agents
                </h2>
                <p class="text-gray-500 text-lg mb-10 leading-relaxed">
                    Our team consists of the most experienced professionals in
                    the industry, dedicated to finding your perfect luxury
                    residence.
                </p>
                <a
                    href="/listings"
                    class="inline-flex items-center px-8 py-4 bg-primary text-white rounded-xl font-bold hover:bg-secondary transition-all shadow-lg hover:shadow-primary/30"
                >
                    View All Properties
                    <ArrowRight size={20} class="ml-2" />
                </a>
            </div>
            <div class="lg:w-2/3 grid grid-cols-1 sm:grid-cols-3 gap-8 w-full">
                {
                    topAgents.map((agent) => (
                        <div class="group bg-background-base p-8 rounded-3xl text-center hover:bg-primary transition-all duration-500">
                            <div class="relative w-32 h-32 mx-auto mb-6">
                                <div class="absolute inset-0 bg-accent rounded-full -rotate-6 group-hover:rotate-6 transition-transform" />
                                <img
                                    src={agent.image}
                                    alt={agent.name}
                                    class="relative w-full h-full object-cover rounded-full border-4 border-white shadow-lg"
                                />
                            </div>
                            <h3 class="text-xl font-bold mb-1 group-hover:text-white transition-colors">
                                {agent.name}
                            </h3>
                            <p class="text-accent font-medium mb-4">
                                {agent.role}
                            </p>
                            <div class="flex items-center justify-center text-xs font-bold text-gray-400 group-hover:text-gray-300">
                                <TrendingUp size={14} class="mr-1.5" />
                                {agent.stats}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
