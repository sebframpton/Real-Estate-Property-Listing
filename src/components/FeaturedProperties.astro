---
import { ArrowRight } from "lucide-astro";
import PropertyCard from "./PropertyCard.astro";
import properties from "../data/properties.json";

const featuredProperties = properties
    .filter((p) => p.type === "House")
    .slice(0, 6);
---

<section class="py-24 bg-background-base">
    <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16">
            <div>
                <h2 class="text-4xl font-bold mb-4">
                    Featured <span class="text-accent">Properties</span>
                </h2>
                <p class="text-gray-500 max-w-xl">
                    Our hand-picked selection of the most exclusive properties
                    currently on the market.
                </p>
            </div>
            <a
                href="/listings"
                class="mt-6 md:mt-0 px-8 py-3 bg-white border border-gray-200 rounded-xl font-bold hover:bg-primary hover:text-white hover:border-primary transition-all flex items-center group"
            >
                Browse All
                <ArrowRight
                    size={20}
                    class="ml-2 transform group-hover:translate-x-1 transition-transform"
                />
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {
                featuredProperties.map((property) => (
                    <PropertyCard {...property} />
                ))
            }
        </div>
    </div>
</section>
