---
export interface Props {
    currentPage: number;
    totalPages: number;
    baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

// Generate array of page numbers to show
function getPageNumbers() {
    const pages = [];
    const maxVisiblePages = 5;

    if (totalPages <= maxVisiblePages) {
        for (let i = 1; i <= totalPages; i++) {
            pages.push(i);
        }
    } else {
        if (currentPage <= 3) {
            pages.push(1, 2, 3, 4, "...", totalPages);
        } else if (currentPage >= totalPages - 2) {
            pages.push(
                1,
                "...",
                totalPages - 3,
                totalPages - 2,
                totalPages - 1,
                totalPages,
            );
        } else {
            pages.push(
                1,
                "...",
                currentPage - 1,
                currentPage,
                currentPage + 1,
                "...",
                totalPages,
            );
        }
    }
    return pages;
}

const pages = getPageNumbers();
---

<div class="mt-16 flex justify-center items-center space-x-2 sm:space-x-4">
    {
        currentPage > 1 ? (
            <a
                href={`${baseUrl}page=${currentPage - 1}`}
                class="p-2 sm:p-3 rounded-xl border border-gray-200 text-gray-400 hover:border-accent hover:text-accent transition-all inline-flex bg-white shadow-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"
                    />
                </svg>
            </a>
        ) : (
            <button
                class="p-2 sm:p-3 rounded-xl border border-gray-200 text-gray-400 opacity-50 cursor-not-allowed transition-all inline-flex bg-gray-50"
                disabled
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"
                    />
                </svg>
            </button>
        )
    }

    <div class="flex space-x-1 sm:space-x-2 items-center">
        {
            pages.map((page, index) =>
                page === "..." ? (
                    <span class="w-8 h-10 sm:w-12 sm:h-12 flex items-center justify-center text-gray-400 font-bold text-sm sm:text-base">
                        ...
                    </span>
                ) : (
                    <a
                        href={`${baseUrl}page=${page}`}
                        class={`w-9 h-10 sm:w-12 sm:h-12 flex items-center justify-center rounded-xl font-bold transition-all text-sm sm:text-base shadow-sm ${
                            page === currentPage
                                ? "bg-accent text-secondary"
                                : "bg-white border border-gray-200 hover:border-accent hover:text-accent text-gray-700"
                        } ${index > 0 && index < pages.length - 1 ? "hidden min-[400px]:flex" : "flex"}`}
                    >
                        {page}
                    </a>
                ),
            )
        }
        <span class="text-sm font-bold text-gray-400 min-[400px]:hidden px-2">
            Page {currentPage} of {totalPages}
        </span>
    </div>

    {
        currentPage < totalPages ? (
            <a
                href={`${baseUrl}page=${currentPage + 1}`}
                class="p-2 sm:p-3 rounded-xl border border-gray-200 text-gray-400 hover:border-accent hover:text-accent transition-all inline-flex bg-white shadow-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                    />
                </svg>
            </a>
        ) : (
            <button
                class="p-2 sm:p-3 rounded-xl border border-gray-200 text-gray-400 opacity-50 cursor-not-allowed transition-all inline-flex bg-gray-50"
                disabled
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                    />
                </svg>
            </button>
        )
    }
</div>
